<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/loans/#{@loan}/edit"}>
      <.button>Ausleihe bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Kontakt">
      {format_string_field(@loan.contact.name)}
    </:item>
    <:item title="Standort">
      {format_string_field(@loan.location.name)}
    </:item>
    <:item title="Einheit">
      {format_string_field(@loan.unit.serial_number)}
    </:item>
    <:item title="Rückgabedatum">
      {format_date_field_dmy(@loan.return_date)}
    </:item>
  </.list>
</.card>

<.back navigate={~p"/articles/#{@article}"}>Zurück zur Artikelansicht</.back>
