<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/units/#{@unit}/edit"}>
      <.button>Einheit bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Serial number">{@unit.serial_number}</:item>
    <:item title="For lending">{@unit.for_lending}</:item>
    <:item title="For booking">{@unit.for_booking}</:item>
  </.list>
</.card>
