<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/categories/#{@category}/edit"}>
      <.button>Ausrüstungskategorie bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Name">{@category.name}</:item>
    <:item title="Beschreibung">{@category.description}</:item>
    <:item title="Ausleihzeitraum">{@category.loan_period}</:item>
  </.list>
</.card>

<.back navigate={~p"/clubs/#{@club.id}/categories"}>Zurück zu den Kategorien</.back>

