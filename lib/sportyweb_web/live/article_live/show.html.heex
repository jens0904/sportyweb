<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/articles/#{@article}/edit"}>
      <.button>Artikel bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Name">{@article.name}</:item>
    <:item title="Beschreibung">{@article.description}</:item>
    <:item title="Referenznummer">{@article.reference_number}</:item>
    <:item title="Wiederbeschaffungskosten">{@article.costs_of_loss}</:item>
    <:item title="Abteilung">
      {if @article.department, do: @article.department.name, else: "-"}
    </:item>
    <:item title="Kategorie">
      {if @article.category, do: @article.category.name, else: "-"}
    </:item>
    <:item title="Definierter Überlassungszeitraum in Tagen">
      {format_integer_field(@article.loan_period)}
    </:item>
    <:item title="Überlassung an Vereinsmitglieder erlauben">
      {if @article.for_club_members, do: "Ja", else: "Nein"} 
    </:item>
    <:item title="Überlassung an Nichtmitglieder erlauben">
      {if @article.for_non_members, do: "Ja", else: "Nein"} 
    </:item>
    <:item title="Verlängerung erlauben">
      {if @article.allow_renewal, do: "Ja", else: "Nein"} 
    </:item>
    <:item title="Maximale Anzahl an Verlängerungen">
      {if @article.max_renewals, do: @article.max_renewals, else: "-"}
    </:item>
    <:item title="Verlängerungszeitraum in Tagen">
      {if @article.renewal_period, do: @article.renewal_period, else: "-"}
    </:item>
  </.list>
</.card>

<.header level="2" class="mt-12">
  Ausleihen
  <:actions>
    <.link navigate={~p"/articles/#{@article}/loans/new"}>
      <.button>Ausleihe anlegen</.button>
    </.link>
  </:actions>
</.header>
<.card>
  <%= if Enum.any?(@streams.loans.inserts) do %>
    <.table
      id="loan"
      rows={@streams.loans}
      row_click={fn {_id, loan} -> JS.navigate(~p"/loans/#{loan}") end}
    >
      <:col :let={{_id, loan}} label="Kontakt">
        {format_string_field(loan.contact.name)}
      </:col>
      <:col :let={{_id, loan}} label="Standort">
        {format_string_field(loan.location.name)}
      </:col>
      <:col :let={{_id, loan}} label="Einheit">
        {format_integer_field(loan.unit.serial_number)}
      </:col>
      <:col :let={{_id, loan}} label="Rückgabedatum">
        <div class="max-w-[200px] truncate overflow-hidden">
          {format_date_field_dmy(loan.return_date)}
        </div>
      </:col>
      <:action :let={{_id, loan}}>
        <.link navigate={~p"/loans/#{loan}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>Es gibt keine aktiven Ausleihvorgänge</p>
  <% end %>
</.card>

<.header level="2" class="mt-12">
  Einheiten
  <:actions>
    <.link navigate={~p"/articles/#{@article}/units/new"}>
      <.button>Einheit erstellen</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <%= if Enum.any?(@streams.units.inserts) do %>
    <.table
      id="unit"
      rows={@streams.units}
      row_click={fn {_id, unit} -> JS.navigate(~p"/units/#{unit}") end}
    >
      <:col :let={{_id, unit}} label="Anlagennummer">
        {format_integer_field(unit.serial_number)}
      </:col>
      <:col :let={{_id, unit}} label="belegt">
        {format_boolean_field(unit.occupied)}
      </:col>
      <:col :let={{_id, unit}} label="ausleihbar">
        <div class="max-w-[200px] truncate overflow-hidden">
          {format_boolean_field(unit.for_lending)}
        </div>
      </:col>
      <:col :let={{_id, unit}} label="Standort">
        {format_string_field(unit.location.name)}
      </:col>
      <:action :let={{_id, unit}}>
        <.link navigate={~p"/units/#{unit}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>Bisher wurde noch keine Einheit angelegt.</p>
  <% end %>
</.card>


<.header level="2" class="mt-12">
  Mietgebühr
  <:actions>
    <.link navigate={~p"/articles/#{@article}/rental_fees/new"}>
      <.button>Mietgebühr erstellen</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <%= if Enum.any?(@streams.rental_fees.inserts) do %>
    <.table
      id="rental_fee"
      rows={@streams.rental_fees}
      row_click={fn {_id, rental_fee} -> JS.navigate(~p"/rental_fees/#{rental_fee}") end}
    >
      <:col :let={{_id, rental_fee}} label="Name">
        {format_string_field(rental_fee.name)}
      </:col>

      <:col :let={{_id, rental_fee}} label="Für wen gilt die Gebühr?">
  <%= case rental_fee.member_type do %>
    <% :member -> %>Mitglieder
    <% :non_member -> %>Nichtmitglieder
    <% _ -> %>–
  <% end %>
</:col>

<:col :let={{_id, rental_fee}} label="Mietdauer">
  <%= case rental_fee.rental_duration do %>
    <% :short_term -> %>Kurzfristige Vermietungen
    <% :long_term -> %>Langfristige Vermietungen
    <% _ -> %>–
  <% end %>
</:col>

      <:col :let={{_id, rental_fee}} label="Betrag">
        {Money.to_string!(rental_fee.amount)}
      </:col>

      <:col :let={{_id, rental_fee}} label="Mindestalter">
        {format_integer_field(rental_fee.minimum_age_in_years)}
      </:col>

      <:col :let={{_id, rental_fee}} label="Höchstalter">
        {format_integer_field(rental_fee.maximum_age_in_years)}
      </:col>

      <:action :let={{_id, rental_fee}}>
        <.link navigate={~p"/rental_fees/#{rental_fee}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>Bisher wurde noch keine Mietgebühr angelegt.</p>
  <% end %>
</.card>
