<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/articles/#{@article}/edit"}>
      <.button>Artikel bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Name">{@article.name}</:item>
    <:item title="Beschreibung">{@article.description}</:item>
    <:item title="Referenznummer">{@article.reference_number}</:item>
    <:item title="Wiederbeschaffungskosten">{@article.costs_of_loss}</:item>
  </.list>
</.card>

<.header level="2" class="mt-12">
  Einheiten
  <:actions>
    <.link navigate={~p"/articles/#{@article}/units/new"}>
      <.button>Einheit erstellen</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <%= if Enum.any?(@streams.units.inserts) do %>
    <.table
      id="unit"
      rows={@streams.units}
      row_click={fn {_id, unit} -> JS.navigate(~p"/units/#{unit}") end}
    >
      <:col :let={{_id, unit}} label="Anlagennummer">
        {format_integer_field(unit.serial_number)}
      </:col>
      <:col :let={{_id, unit}} label="buchbar">
        {format_boolean_field(unit.for_booking)}
      </:col>
      <:col :let={{_id, unit}} label="ausleihbar">
        <div class="max-w-[200px] truncate overflow-hidden">
          {format_boolean_field(unit.for_lending)}
        </div>
      </:col>
      <:col :let={{_id, unit}} label="Standort">
        {format_string_field(unit.location.name)}
      </:col>

      <:action :let={{_id, unit}}>
        <.link navigate={~p"/units/#{unit}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>Bisher wurde noch keine Einheit angelegt.</p>
  <% end %>
</.card>
