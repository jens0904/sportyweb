<.header>
  Listing Rental fee
  <:actions>
    <.link patch={~p"/rental_fee/new"}>
      <.button>New Rental fee</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="rental_fee"
  rows={@streams.rental_fee_collection}
  row_click={fn {_id, rental_fee} -> JS.navigate(~p"/rental_fee/#{rental_fee}") end}
>
    <:col :let={{_id, rental_fee}} label="Name">
    {rental_fee.name}
  </:col>

  <:col :let={{_id, rental_fee}} label="Für wen gilt die Gebühr?">
    <%= case rental_fee.member_type do %>
      <% :member -> %>Mitglieder
      <% :non_member -> %>Nichtmitglieder
      <% _ -> %>–
    <% end %>
  </:col>

  <:col :let={{_id, rental_fee}} label="Mietdauer">
    <%= case rental_fee.rental_duration do %>
      <% :short_term -> %>Kurzfristig
      <% :long_term -> %>Langfristig
      <% _ -> %>–
    <% end %>
  </:col>

  <:col :let={{_id, rental_fee}} label="Mindestalter">
    {rental_fee.minimum_age_in_years || "–"}
  </:col>

  <:col :let={{_id, rental_fee}} label="Höchstalter">
    {rental_fee.maximum_age_in_years || "–"}
  </:col>
  <:action :let={{_id, rental_fee}}>
    <div class="sr-only">
      <.link navigate={~p"/rental_fee/#{rental_fee}"}>Show</.link>
    </div>
    <.link patch={~p"/rental_fee/#{rental_fee}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, rental_fee}}>
    <.link
      phx-click={JS.push("delete", value: %{id: rental_fee.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

